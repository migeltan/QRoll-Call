# Copy to backend/supabase/functions/.env (gitignored) and fill in. Owner: Role 3.
# NEVER commit the real .env file.

# Shared secret between the database webhook and the Edge Function.
WEBHOOK_SECRET=change-me

# Email provider: pick ONE (decide with the Lead whether we have a verified domain for Resend).
RESEND_API_KEY=
EMAIL_FROM="Event Check-in <onboarding@resend.dev>"

# Gmail SMTP fallback (use a Google "app password", not the real password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Event name shown in the email.
EVENT_NAME=Our Event
